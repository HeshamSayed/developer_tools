# API Configuration
VITE_API_BASE_URL=http://localhost:8000

# Google AdSense Configuration
# Get these from your Google AdSense account (https://adsense.google.com)
VITE_ADSENSE_ENABLED=true
VITE_ADSENSE_TEST_MODE=true
VITE_ADSENSE_PUBLISHER_ID=ca-pub-XXXXXXXXXXXXXXXX

# Ad Slot IDs - Create these in your AdSense dashboard
VITE_ADSENSE_SLOT_TOP_BANNER=1234567890
VITE_ADSENSE_SLOT_SIDEBAR=1234567891
VITE_ADSENSE_SLOT_IN_CONTENT=1234567892
VITE_ADSENSE_SLOT_BOTTOM_BANNER=1234567893
VITE_ADSENSE_SLOT_MOBILE_BANNER=1234567894
VITE_ADSENSE_SLOT_IN_FEED=1234567895
VITE_ADSENSE_SLOT_MULTIPLEX=1234567896
VITE_ADSENSE_SLOT_ANCHOR=1234567897
VITE_ADSENSE_SLOT_SIDEBAR_2=1234567898
VITE_ADSENSE_SLOT_VIGNETTE=1234567899

# Advanced Revenue Features
# Auto Ads - Let Google's ML optimize placement (+10-30% revenue)
VITE_ADSENSE_AUTO_ADS=false

# Anchor Ads - Sticky mobile ads at bottom (+30% mobile revenue)
VITE_ADSENSE_ANCHOR_ADS=true

# Multiplex Ads - Related content with ads (+20% bottom-page revenue)
VITE_ADSENSE_MULTIPLEX_ADS=true

# Vignette Ads - Full-screen popup between page navigation (high CPM, use sparingly)
VITE_ADSENSE_VIGNETTE_ADS=false

# SPA Ad Refresh - Refresh ads on route change (use carefully, max 10 times)
VITE_ADSENSE_SPA_REFRESH=false

# Feature Flags
VITE_ENABLE_ANALYTICS=false
