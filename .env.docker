# Docker Environment Configuration for Developer Tools Platform

# Django Backend Configuration
DEBUG=True
SECRET_KEY=django-insecure-dev-key-change-in-production-REPLACE-ME
ALLOWED_HOSTS=localhost,127.0.0.1,backend,0.0.0.0

# Database Configuration (PostgreSQL)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=developer_tools
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=db
DB_PORT=5432

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8000

# Google AdSense Configuration (Optional)
VITE_ADSENSE_ENABLED=false
VITE_ADSENSE_TEST_MODE=true
VITE_ADSENSE_PUBLISHER_ID=ca-pub-XXXXXXXXXXXXXXXX
VITE_ADSENSE_AUTO_ADS=false
VITE_ADSENSE_ANCHOR_ADS=false
VITE_ADSENSE_MULTIPLEX_ADS=false
VITE_ADSENSE_VIGNETTE_ADS=false

# Feature Flags
VITE_ENABLE_ANALYTICS=false
